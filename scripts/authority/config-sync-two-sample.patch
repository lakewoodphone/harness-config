+#: The two-sample memory for check_config_sync. A single non-clean sample is the
+#: 15-minute autosync cache, not a divergence; HIGH needs two consecutive samples.
+CONFIG_SYNC_STATE = Path(os.environ.get(
+    "CONFIG_SYNC_STATE", "/var/lib/ceo-kernel/config-sync-state.json"))
+
+
+def _load_config_sync_state():
+    try:
+        return json.loads(CONFIG_SYNC_STATE.read_text(encoding="utf-8"))
+    except Exception:  # missing or unreadable state is "no previous sample"
+        return None
+
+
+def _save_config_sync_state(obj):
+    CONFIG_SYNC_STATE.parent.mkdir(parents=True, exist_ok=True)
+    tmp = CONFIG_SYNC_STATE.with_suffix(".tmp")
+    tmp.write_text(json.dumps(obj), encoding="utf-8")
+    tmp.replace(CONFIG_SYNC_STATE)
