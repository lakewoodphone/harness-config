[Unit]
Description=Owner text channel safety check - read-only invariants, one status file
Documentation=file:/usr/local/bin/text-health-check.sh
After=company-api.service

[Service]
Type=oneshot
Environment=HOME=/root
Environment=AITEXT_APP=/root/personal-secretary-mvp
Environment=AITEXT_BIN=/root/bin
Environment=AITEXT_SMS_DIR=/root/.sms-inbox
ExecStart=/usr/local/bin/text-health-check.sh
TimeoutStartSec=240
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
