# harness-config: single source of truth for the DSH harness across all machines.
# See README.md.

# machine-local / secrets -- never commit
*.bak-*
.credentials.yaml
.anonymous-user-id

# python
__pycache__/
*.pyc
.venv/

# dsh runtime state, if ever mirrored here
sessions/
profiles/node_modules/
storages/

# os
Thumbs.db
desktop.ini
.DS_Store
checkmerge.py

# per-machine hidden-task launchers, regenerated by scripts/Set-TaskHidden.ps1
scripts/hidden-tasks/

# _scratch/ -- 2026-09-18. One-off probes, measurement scripts and pasted transcripts live here, and
# nothing in it is a product artifact. It held 157 untracked files and that alone made `git status`
# dirty, which made `agent-fleet doctor` report "base clean: NO", which made `agent-fleet new` refuse --
# i.e. the directory name was silently blocking the worktree-fleet capability. Ignored now, so the base
# is clean and a fleet can start. The 16 files already tracked under it stay tracked (gitignore does not
# affect tracked paths); force-add a future scratch artifact with `git add -f` only if another machine
# genuinely needs it, and prefer docs/ or scripts/ if it does.
_scratch/
