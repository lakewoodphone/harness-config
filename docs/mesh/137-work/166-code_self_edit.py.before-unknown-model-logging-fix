# ── Resilience constants ─────────────────────────────────────────────
_MAX_LLM_RETRIES = 3
_RETRY_BACKOFF_BASE = 2.0  # seconds; exponential
_SNAPSHOT_DIR = "data/code_snapshots"  # last-known-good backups
_MAX_SNAPSHOTS = 50  # rolling window

# ── Isolated apply ───────────────────────────────────────────────────
# `apply_proposal` wrote wherever it was pointed at, and in production it is pointed at the live
# checkout serving the API (app/main.py resolves `Path(__file__).parents[1]`; app/evolution.py uses
# its own `_repo_root()`), which is why CODE_EDIT_AUTO_APPLY has been false since 2026-06-12
# (evolution_changelog holds 1 row with commit_sha NULL since 2026-04-22).
#
# A root must now carry the sentinel below -- written only by `make_isolated_apply_root()` -- before
# any write is allowed through, and the running checkout is refused unconditionally. Applying into a
# throwaway copy is how a proposal can still be exercised end to end.
_ISOLATION_SENTINEL = ".code_edit_isolated"
_LIVE_CHECKOUT_ROOT = Path(__file__).resolve().parents[1]

# ── Offer ledger ─────────────────────────────────────────────────────
# Bookkeeping, not history: bounded, oldest key dropped first. `offer_keys` remembers that this
# exact offer was already produced (never pay twice); `noop_keys` remembers that it was produced and
# came back byte-identical (never pay again at all).
_MAX_TRACKED_KEYS = 500

# Attribute the spend to its own agent so it is visible and separable in model_usage / budgets.
_USAGE_AGENT_ID = "self_improvement"
_USAGE_TASK_TYPE = "code_proposal"


class LiveCheckoutWriteRefused(RuntimeError):
    """Raised when a write would land in the live checkout or in an unmarked root."""


def _utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def _safe_text(value: Any) -> str:
    return str(value or "").strip()


def _sha256(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8", errors="ignore")).hexdigest()


# Minimal safety: only block .git internals and compiled cache.
# Everything else is fair game — .env, secrets, data, all of it.
_DENY_PREFIXES = (
    ".git/",
    "__pycache__/",
    ".mypy_cache/",
    ".pytest_cache/",
    "node_modules/",
    "data/secretary.db",
    "data/secretary.sqlite",
    "data/secretary.sqlite3",
    # Deployment & build config — never auto-edit
    "requirements",  # requirements.txt, requirements-dev.txt
    "pyproject.toml",
    "setup.py",
    "setup.cfg",
    "dockerfile",
    "docker-compose",
    "makefile",
    "alembic/",
    ".github/",
)


# ── Last-known-good snapshot system ──────────────────────────────────


def _snapshot_dir(repo_root: Path) -> Path:
    return repo_root / _SNAPSHOT_DIR


def _save_snapshot(
    repo_root: Path,
    files: dict[str, str],
    label: str = "",
) -> str:
    """Save a snapshot of files before editing (last-known-good).

    Returns the snapshot ID.
    """
    guard_write_root(repo_root)
    snap_dir = _snapshot_dir(repo_root)
    snap_dir.mkdir(parents=True, exist_ok=True)

    snap_id = hashlib.sha256(f"{_utc_now_iso()}::{label}".encode()).hexdigest()[:12]
    snap_path = snap_dir / f"{snap_id}.json"

    payload = {
        "id": snap_id,
        "label": label,
        "created_at": _utc_now_iso(),
        "files": {
            rel: {"content": content, "sha256": _sha256(content)}
            for rel, content in files.items()
        },
    }
    # Atomic write: temp file then replace
    tmp_path = snap_path.with_suffix(".tmp")
    try:
        tmp_path.write_text(
            json.dumps(payload, indent=2, ensure_ascii=False),
            encoding="utf-8",
        )
        import os

        os.replace(str(tmp_path), str(snap_path))
    except OSError:
        # Fallback: direct write
        snap_path.write_text(
            json.dumps(payload, indent=2, ensure_ascii=False),
            encoding="utf-8",
        )
        try:
            tmp_path.unlink(missing_ok=True)
        except OSError:
            pass

    # Prune old snapshots
    try:
        snaps = sorted(
            snap_dir.glob("*.json"),
            key=lambda p: p.stat().st_mtime,
        )
        for old in snaps[:-_MAX_SNAPSHOTS]:
            old.unlink(missing_ok=True)
    except Exception:
        pass

    log.info("Snapshot saved: %s (%d files)", snap_id, len(files))
    return snap_id


def _restore_snapshot(
    repo_root: Path,
    snap_id: str,
) -> dict[str, Any]:
    """Restore files from a last-known-good snapshot."""
    try:
        guard_write_root(repo_root)
    except LiveCheckoutWriteRefused as exc:
        return {"ok": False, "error": str(exc), "refused": True, "restored": [], "errors": []}
    snap_path = _snapshot_dir(repo_root) / f"{snap_id}.json"
    if not snap_path.exists():
        return {"ok": False, "error": f"Snapshot {snap_id} not found"}

    data = json.loads(snap_path.read_text(encoding="utf-8"))
    files = data.get("files", {})
    restored: list[str] = []
    errors: list[str] = []

    for rel, info in files.items():
        try:
            _write_text(repo_root, rel, info["content"])
            restored.append(rel)
        except Exception as exc:
            errors.append(f"{rel}: {exc}")

    log.info(
        "Snapshot %s restored: %d files, %d errors",
        snap_id,
        len(restored),
        len(errors),
    )
    return {
        "ok": len(errors) == 0,
        "snapshot_id": snap_id,
        "restored": restored,
        "errors": errors,
    }


def list_snapshots(repo_root: str) -> list[dict[str, Any]]:
    """List available last-known-good snapshots."""
    snap_dir = _snapshot_dir(Path(repo_root).resolve())
    if not snap_dir.exists():
        return []
    result = []
    for p in sorted(
        snap_dir.glob("*.json"), key=lambda f: f.stat().st_mtime, reverse=True
    ):
        try:
            data = json.loads(p.read_text(encoding="utf-8"))
            result.append(
                {
                    "id": data.get("id", p.stem),
                    "label": data.get("label", ""),
                    "created_at": data.get("created_at", ""),
                    "file_count": len(data.get("files", {})),
                }
            )
        except Exception:
            continue
    return result[:_MAX_SNAPSHOTS]


def restore_last_known_good(
    repo_root: str,
    snap_id: str | None = None,
) -> dict[str, Any]:
    """Public API: restore from a snapshot (latest if no ID given)."""
    repo = Path(repo_root).resolve()
    if snap_id:
        return _restore_snapshot(repo, snap_id)
    snaps = list_snapshots(repo_root)
    if not snaps:
        return {"ok": False, "error": "No snapshots available"}
    return _restore_snapshot(repo, snaps[0]["id"])


def _normalize_rel_path(rel_path: str) -> str:
    """Normalize a repo-relative path without eating leading dots.

    `lstrip("./")` used to sit here, and `str.lstrip` treats its argument as a character set, so it
    stripped every leading `.` and `/`: `.env` became `env` and `.git/config` became `git/config`,
    which meant the `.env` and `.git/` denials below could never fire. Only a literal leading `./` is
    removed now -- dotfiles keep their dot and stay matched by the rules meant to stop them.
    """
    rel = str(rel_path or "").replace("\\", "/").strip()
    while rel.startswith("./"):
        rel = rel[2:]
    return rel


def _is_vendored_rel_path(rel_path: str) -> bool:
    """True when any path segment is a vendored or generated tree.

    Delegates to the single per-segment rule the rest of the codebase already uses
    (app/database.py: `_is_vendored_path`) instead of keeping a third copy of it. That helper
    matches whole segments, so `web/node_modules/pkg/index.js` is caught at any depth, which the
    prefix list below could not do (measured: 19 evolution offers, 18 of them in the last 30 days,
    targeted `web/node_modules/flatted/python/flatted.py`).
    """
    from app.database import _is_vendored_path as _shared_is_vendored_path

    return bool(_shared_is_vendored_path(rel_path))


def _is_denied_rel_path(rel_path: str) -> bool:
    rel = _normalize_rel_path(rel_path)
    if not rel or rel.startswith("/"):
        return True
    if ".." in rel.split("/"):
        return True
    lowered = rel.lower()

    # Block live env/secrets files, but allow .env.example.
    if lowered == ".env":
        return True
    if lowered.startswith(".env.") and lowered != ".env.example":
        return True

    for prefix in _DENY_PREFIXES:
        if lowered.startswith(prefix):
            return True

    # Vendored/generated trees, at any depth and under either path separator. `startswith` above only
    # sees `node_modules/...`, `venv/...`, `site-packages/...`, `.next/...` etc. when they sit at the
    # repository root, so `web/node_modules/pkg/index.js` slipped through the whole filter.
    if _is_vendored_rel_path(rel):
        return True
    return False


def _is_allowed_rel_path(settings: Settings | None, rel_path: str) -> bool:
    rel = _normalize_rel_path(rel_path)
    if _is_denied_rel_path(rel):
        return False
    # Full access mode — no restrictions beyond path-escape and .git
    return True


def _resolve_in_repo(repo_root: Path, rel_path: str) -> Path:
    rel = _normalize_rel_path(rel_path)
    path = (repo_root / rel).resolve()
    if repo_root != path and repo_root not in path.parents:
        raise ValueError("Path escape detected")
    return path


# ── Write isolation ──────────────────────────────────────────────────


def is_isolated_apply_root(repo_root: str | Path) -> bool:
    """True when this root carries the isolation sentinel written by `make_isolated_apply_root()`."""
    try:
        root = Path(repo_root).resolve()
    except (OSError, ValueError):
        return False
    return (root / _ISOLATION_SENTINEL).exists()


def guard_write_root(repo_root: str | Path) -> Path:
    """Return the resolved root, or refuse the write.

    Two rules, both load-bearing:

    1. the running checkout is refused unconditionally -- even if somebody marked it, nothing may
       write into the tree the API is serving out of;
    2. any other root must be marked isolated. That is what makes "the flag is off because it is not
       yet trusted" instead of "the flag is off because the code path is dangerous".

    Raises:
        LiveCheckoutWriteRefused: when a write into this root must not happen.
    """
    try:
        root = Path(repo_root).resolve()
    except (OSError, ValueError) as exc:  # pragma: no cover - defensive
        raise LiveCheckoutWriteRefused(f"unresolvable apply root {repo_root!r}: {exc}") from exc

    if root == _LIVE_CHECKOUT_ROOT:
        raise LiveCheckoutWriteRefused(
            f"refusing to write into the live checkout ({root}); unset CODE_EDIT_AUTO_APPLY and "
            f"apply into an isolated root from make_isolated_apply_root() instead"
        )
    if not (root / _ISOLATION_SENTINEL).exists():
        raise LiveCheckoutWriteRefused(
            f"refusing to write into {root}: not an isolated apply root (missing "
            f"{_ISOLATION_SENTINEL}); create one with make_isolated_apply_root()"
        )
    return root


def make_isolated_apply_root(
    *,
    source_root: str,
    rel_paths: list[str],
    state_path: str | None = None,
    dest: str | None = None,
) -> Path:
    """Create a throwaway copy of the given files, marked as an isolated apply root.

    The copy is what the applier writes into and validates, so a proposal can be exercised end to
    end while the source tree is only ever read. `dest` defaults to a fresh directory under the
    system temp dir; the caller owns cleanup.
    """
    source = Path(source_root).resolve()
    root = Path(dest).resolve() if dest else Path(tempfile.mkdtemp(prefix="code_edit_isolated_"))
    root.mkdir(parents=True, exist_ok=True)

    wanted = [str(p) for p in rel_paths]
    if state_path:
        wanted.append(str(state_path))

    for rel in wanted:
        src = _resolve_in_repo(source, rel)
        if not src.exists() or not src.is_file():
            continue
        dst = _resolve_in_repo(root, rel)
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(str(src), str(dst))

    (root / _ISOLATION_SENTINEL).write_text(
        "isolated apply root: writes here are throwaway verification, never the source tree\n",
        encoding="utf-8",
    )
    return root


def _read_text(repo_root: Path, rel_path: str) -> str:
    path = _resolve_in_repo(repo_root, rel_path)
    if not path.exists() or not path.is_file():
        raise ValueError(f"File not found: {rel_path}")
    return path.read_text(encoding="utf-8", errors="replace")


def _read_text_if_exists(repo_root: Path, rel_path: str) -> tuple[bool, str]:
    path = _resolve_in_repo(repo_root, rel_path)
    if not path.exists():
        return False, ""
    if not path.is_file():
        raise ValueError(f"Not a file: {rel_path}")
    return True, path.read_text(encoding="utf-8", errors="replace")


def _write_text(
    repo_root: Path,
    rel_path: str,
    content: str,
) -> None:
    # Every write in this module funnels through here, so this is where isolation is enforced.
    guard_write_root(repo_root)
    path = _resolve_in_repo(repo_root, rel_path)
    path.parent.mkdir(parents=True, exist_ok=True)
    # Atomic write: write to tmp then replace
    tmp = path.with_suffix(path.suffix + ".tmp")
    try:
        tmp.write_text(content, encoding="utf-8")
        import os

        os.replace(str(tmp), str(path))
    except OSError:
        # Fallback: direct write
        path.write_text(content, encoding="utf-8")
        try:
            tmp.unlink(missing_ok=True)
        except OSError:
            pass


def _unified_diff(path: str, before: str, after: str) -> str:
    return "".join(
        difflib.unified_diff(
            before.splitlines(True),
            after.splitlines(True),
            fromfile=path,
            tofile=path,
        )
    )


def _diff_line_count(diff_text: str) -> int:
    return len([ln for ln in (diff_text or "").splitlines() if ln.strip()])


def _extract_json(text: str) -> str:
    stripped = text.strip()
    if stripped.startswith("{") and stripped.endswith("}"):
        return stripped

    # Robust extraction: scan for the first valid JSON object in the output.
    # Avoid greedy regexes which can swallow extra braces and create invalid
    # JSON (common when models include explanations or tool output).
    decoder = json.JSONDecoder()
    fallback: str | None = None
    for m in re.finditer(r"\{", stripped):
        start = m.start()
        try:
            obj, end = decoder.raw_decode(stripped[start:])
        except json.JSONDecodeError:
            continue
        if isinstance(obj, dict):
            candidate = stripped[start : start + end]
            # Prefer objects that look like our proposal schema.
            if (
                isinstance(obj.get("files"), (list, dict))
                or isinstance(obj.get("changes"), list)
                or isinstance(obj.get("edits"), dict)
                or isinstance(obj.get("file"), dict)
                or (obj.get("path") and obj.get("content"))
            ):
                return candidate
            fallback = candidate

    if fallback:
        return fallback

    raise ValueError("Model output did not include a valid JSON object.")


