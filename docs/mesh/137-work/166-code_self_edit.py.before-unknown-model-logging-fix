def _call_openai(
    settings: Settings,
    system_prompt: str,
    user_prompt: str,
    llm_tier: str | None = None,
) -> tuple[str, str, str, dict[str, Any] | None]:
    """Call OpenAI via LangChain. Raises on failure. Returns (provider, model, text, usage)."""
    from langchain_openai import ChatOpenAI
    from langchain_core.messages import HumanMessage
    from langchain_core.messages import SystemMessage

    tier = str(llm_tier or "").strip().lower()
    # A TIER IS A *CATALOGUE* ID (`deepseek/deepseek-v4-flash`), NOT A PROVIDER MODEL ID.
    # MEASURED 2026-10-07: this branch handed that catalogue id straight to
    # api.openai.com, which answered `400 invalid model ID` on all three retries of every
    # run; the attempts were recorded as model='unknown' and ten consecutive
    # ai-gateway-health runs exited rc=1 on them. The literals below are the models
    # OpenAI actually deploys (both lifecycle_state='promoted' in model_registry and both
    # already proven successful in model_usage).
    if tier == "ceo":
        model = "gpt-5.4"
    else:
        model = "gpt-5.4-mini"
    llm = ChatOpenAI(
        api_key=settings.openai_api_key,
        model=model,
        temperature=0.2,
        reasoning_effort="low",
        max_completion_tokens=6000,
    )
    response = llm.invoke(
        [
            SystemMessage(content=system_prompt),
            HumanMessage(content=user_prompt),
        ]
    )
    raw = _safe_text(getattr(response, "content", response))
    return "openai", model, raw, _extract_langchain_usage(response)


