def _call_copilot(
    system_prompt: str,
    user_prompt: str,
) -> tuple[str, str, str, dict[str, Any] | None]:
    """Call Copilot API. Raises on failure. Returns (provider, model, text, usage)."""
    from app.copilot_client import copilot_chat

    model = "gpt-4.1"
    text, usage, _tool_calls = copilot_chat(
        model=model,
        messages=[
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt},
        ],
        temperature=0.2,
        max_tokens=12000,
    )
    return "copilot", model, _safe_text(text), usage if isinstance(usage, dict) else None


def _call_deepinfra(
    settings: Settings,
    system_prompt: str,
    user_prompt: str,
    llm_tier: str | None = None,
) -> tuple[str, str, str, dict[str, Any] | None]:
    """Call DeepInfra (OpenAI-compatible, primary pipe) via LangChain.

    Added 2026-08-23: DeepInfra is the primary direct provider.  Uses the
    DeepSeek V4 Flash 0731 workhorse for routine tiers and V4 Pro 0813 for
    the CEO tier.  Falls back to Fireworks with the same model if DeepInfra
    has no key.  Raises on failure.
    """
    from langchain_core.messages import HumanMessage
    from langchain_core.messages import SystemMessage
    from langchain_openai import ChatOpenAI

    tier = str(llm_tier or "").strip().lower()
    if tier == "ceo":
        model = "deepseek-ai/DeepSeek-V4-Pro-0813"
    else:
        model = "deepseek-ai/DeepSeek-V4-Flash-0731"

    api_key = settings.deepinfra_api_key
    base_url = "https://api.deepinfra.com/v1/openai"
    if not api_key and settings.fireworks_api_key:
        api_key = settings.fireworks_api_key
        base_url = "https://api.fireworks.ai/inference/v1"
        model = (
            "accounts/fireworks/models/deepseek-v4-pro-0813"
            if tier == "ceo"
            else "accounts/fireworks/models/deepseek-v4-flash-0731"
        )
    if not api_key:
        raise RuntimeError(
            "No DeepInfra or Fireworks API key configured for code proposals"
        )

    llm = ChatOpenAI(
        api_key=api_key,
        base_url=base_url,
        model=model,
        temperature=0.2,
        max_tokens=12000,
    )
    response = llm.invoke(
        [
            SystemMessage(content=system_prompt),
            HumanMessage(content=user_prompt),
        ]
    )
    raw = _safe_text(getattr(response, "content", response))
    return "deepinfra", model, raw, _extract_langchain_usage(response)


