{
  "name": "dsh-plugin-session-link",
  "version": "0.1.0",
  "private": true,
  "description": "A session addressable by URL: https://<node>.tail93e6e6.ts.net/#session=<id> opens that session.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "verify": "node --check lib/client.js && node --check lib/index.js"
  }
}
